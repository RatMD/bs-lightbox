{
    "name": "@rat.md/bs-lightbox",
    "version": "2.0.0",
    "description": "A lightweight lightbox for Bootstrap 4 and 5, built on native Carousel and Modal components for smooth, dependency-free image galleries.",
    "keywords": [
        "bootstrap",
        "bootstrap-plugin",
        "lightbox",
        "front-end",
        "web",
        "bs",
        "rat"
    ],
    "homepage": "https://github.com/ratmd/bs-lightbox",
    "author": "rat.md <info@rat.md> (https://rat.md)",
    "license": "MIT",
    "copyright": "rat.md <info@rat.md>",
    "bugs": {
        "url": "https://www.github.com/ratmd/bs-lightbox",
        "email": "sam@pytes.net"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ratmd/bs-lightbox"
    },
    "type": "module",
    "main": "./dist/rat.lightbox.mjs",
    "module": "./dist/rat.lightbox.mjs",
    "types": "./dist/rat.lightbox.d.ts",
    "browser": "./dist/rat.lightbox.js",
    "unpkg": "./dist/rat.lightbox.min.js",
    "jsdelivr": "./dist/rat.lightbox.min.js",
    "exports": {
        ".": {
            "types": "./dist/rat.lightbox.d.ts",
            "import": "./dist/rat.lightbox.mjs"
        }
    },
    "reveal": true,
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite dev --host --cors",
        "build": "vite build",
        "watch": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build && npm run typecheck"
    },
    "dependencies": {},
    "devDependencies": {
        "@rollup/plugin-terser": "^0.4.4",
        "@types/node": "^24.10.1",
        "bootstrap": "^5.3.8",
        "rimraf": "^6.1.2",
        "tslib": "^2.8.1",
        "typescript": "5.8.2",
        "vite": "^7.2.6",
        "vite-plugin-dts": "^4.5.4"
    }
}
